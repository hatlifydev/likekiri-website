# Copia este archivo a .env y completa los valores. .env está en .gitignore.

# Conexión a Postgres (Prisma)
DATABASE_URL=postgresql://likekiri:CHANGE_ME@127.0.0.1:5432/likekiri

# Conexión a Redis (sesiones + cache del registry de módulos)
REDIS_URL=redis://127.0.0.1:6379

# Puerto interno del core. Caddy hace reverse_proxy a 127.0.0.1:PORT (ver docs/adr/001-caddy.md)
PORT=3000

# Secreto de material de sesión. Genera uno con: openssl rand -base64 48
SESSION_SECRET=

# Vigencia de las invitaciones, en horas
INVITE_TTL_HOURS=72

# Ruta al JSON con los módulos registrados (URL del manifest + clave HMAC por módulo)
MODULE_REGISTRY_CONFIG=./config/modules.json

# Orígenes permitidos para remoteEntry de módulos, separados por coma
ALLOWED_REMOTE_ORIGINS=https://cdn.likekiri.com

# URLs públicas de las dos superficies
PUBLIC_BASE_URL=https://likekiri.com
ADMIN_BASE_URL=https://admin.likekiri.com
