#!/bin/bash
# Acciones de operaciones de likekiri, de acción FIJA, invocadas por el módulo
# ops (que corre como 'likekiri') vía sudo restringido. No ejecuta comandos
# arbitrarios: solo git status/commit/push/set-remote sobre el repo canónico.
set -euo pipefail
REPO=/root/likekiri
export GIT_AUTHOR_NAME="likekiri-admin"
export GIT_AUTHOR_EMAIL="admin@likekiri.com"
export GIT_COMMITTER_NAME="likekiri-admin"
export GIT_COMMITTER_EMAIL="admin@likekiri.com"
export HOME=/root
cd "$REPO"

case "${1:-}" in
  status)
    echo "branch=$(git rev-parse --abbrev-ref HEAD)"
    echo "dirty=$(git status --porcelain | wc -l | tr -d ' ')"
    echo "remote=$(git remote get-url origin 2>/dev/null || echo '')"
    ahead=0; behind=0
    if git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
      ahead=$(git rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
      behind=$(git rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)
    fi
    echo "ahead=$ahead"
    echo "behind=$behind"
    echo "lastDate=$(git log -1 --pretty=%cI)"
    echo "last=$(git log -1 --pretty=%s)"   # última línea: el resto es el asunto
    ;;
  commit)
    msg="${2:-}"
    [ -z "$msg" ] && { echo "mensaje requerido" >&2; exit 2; }
    git add -A
    if git diff --cached --quiet; then echo "SIN_CAMBIOS"; exit 0; fi
    git commit -q -m "$msg"
    echo "COMMIT_OK $(git rev-parse --short HEAD)"
    ;;
  push)
    git remote get-url origin >/dev/null 2>&1 || { echo "SIN_REMOTO" >&2; exit 3; }
    git push origin HEAD 2>&1
    ;;
  set-remote)
    url="${2:-}"
    [ -z "$url" ] && { echo "url requerida" >&2; exit 2; }
    git remote remove origin 2>/dev/null || true
    git remote add origin "$url"
    echo "REMOTE_OK"
    ;;
  *)
    echo "acción desconocida: ${1:-}" >&2; exit 1 ;;
esac
