[Unit]
Description=likekiri módulo ejemplo-admin (manifest + estáticos federados)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=likekiri
Group=likekiri
WorkingDirectory=/srv/likekiri/app/modules/ejemplo-admin
EnvironmentFile=/etc/likekiri/module-ejemplo-admin.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
